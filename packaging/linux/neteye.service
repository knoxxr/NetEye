[Unit]
Description=NetEye passive OT/ICS network monitoring sensor
Documentation=file:///opt/neteye/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neteye
Group=neteye
Environment=NETEYE_CONFIG=/etc/neteye/neteye.conf
WorkingDirectory=/var/lib/neteye
ExecStart=/opt/neteye/neteye serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Packet capture needs only these two privileges, not root.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/neteye /etc/neteye
UMask=0027

[Install]
WantedBy=multi-user.target
